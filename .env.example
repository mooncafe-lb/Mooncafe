# Copy to .env for local use ONLY. Never commit a real .env file.
# On Render, set these in the service's Environment tab instead.

# PostgreSQL connection string (from Neon). SECRET.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random string (32+ chars) used to sign admin sessions. SECRET.
SESSION_SECRET=

# One-time token that unlocks the first-admin setup page. SECRET.
SETUP_TOKEN=

NODE_ENV=production
# PORT is provided by Render automatically.
